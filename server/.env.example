# PayFlow Server Environment Configuration Example
# ==================================================
# Copy this file to .env and adjust variables as needed

# Database Connection
# Leave empty to use embedded PostgreSQL (PGlite in ./data/payflow_db)
# Or provide external Postgres: postgresql://username:password@localhost:5432/payflow
DATABASE_URL=

# Server HTTP Port
PORT=5000

# Session Secret Key for owner authentication
SESSION_SECRET=replace_with_a_secure_session_secret_key

# Frontend Web Application URL
APP_BASE_URL=http://localhost:3001

# WhatsApp Business API (Optional - 1-Click WhatsApp direct links work out of the box)
WHATSAPP_API_KEY=

# Email Dispatch Configuration (Nodemailer SMTP)
# Leave empty to use development stream logger
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Scheduled Automation / Cron Secret
CRON_SECRET=replace_with_a_secure_cron_secret
