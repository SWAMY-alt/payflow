# PayFlow Client Environment Configuration Example
# ==================================================
# Copy this file to .env and adjust variables as needed

# Application Branding
VITE_APP_NAME="PayFlow"
VITE_APP_TAGLINE="Smart Billing & Collections for Independent Service Providers"

# Backend API Endpoint (Proxied automatically via Vite in dev)
VITE_API_BASE_URL="http://localhost:5000"

# Default Currency & Locale
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"
