# PayFlow Root Environment Configuration Example
# ================================================
# Copy this file to .env and adjust variables as needed

# Database Connection (Leave empty for embedded PostgreSQL)
DATABASE_URL=

# Server HTTP Port
PORT=5000

# Session Secret Key
SESSION_SECRET=replace_with_a_secure_session_secret_key

# Frontend URL
APP_BASE_URL=http://localhost:3001

# WhatsApp Business API
WHATSAPP_API_KEY=

# SMTP Email Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Scheduled Automation Secret
CRON_SECRET=replace_with_a_secure_cron_secret
